gpio4.direction       = "GPIO_DIR_MODE_OUT";
gpio4.gpioPin.$assign = "GPIO25";

gpio5.direction       = "GPIO_DIR_MODE_OUT";
gpio5.$name           = "Epwm_EN_2";
gpio5.gpioPin.$assign = "GPIO89";

sysctl.splitCode = true;

FPUfastRTS1.$name = "myFFR0";

/**
 * Pinmux solution for unlocked pins/peripherals. This ensures that minor changes to the automatic solver in a future
 * version of the tool will not impact the pinmux you originally saw.  These lines can be completely deleted in order to
 * re-solve from scratch.
 */
epwm1.epwm.epwm_aPin.$suggestSolution = "GPIO0";
epwm1.epwm.epwm_bPin.$suggestSolution = "GPIO1";
epwm2.epwm.epwm_aPin.$suggestSolution = "GPIO2";
epwm2.epwm.epwm_bPin.$suggestSolution = "GPIO3";
epwm3.epwm.epwm_aPin.$suggestSolution = "GPIO8";
epwm3.epwm.epwm_bPin.$suggestSolution = "GPIO9";
epwm4.epwm.$suggestSolution           = "EPWM3";
epwm5.epwm.epwm_aPin.$suggestSolution = "GPIO6";
epwm5.epwm.epwm_bPin.$suggestSolution = "GPIO7";
epwm6.epwm.epwm_aPin.$suggestSolution = "GPIO10";
epwm6.epwm.epwm_bPin.$suggestSolution = "GPIO11";
epwm7.epwm.epwm_aPin.$suggestSolution = "GPIO12";
epwm7.epwm.epwm_bPin.$suggestSolution = "GPIO13";
